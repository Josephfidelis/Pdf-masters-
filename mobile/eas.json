{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://YOUR-BACKEND-URL", "EXPO_PUBLIC_USE_TEST_ADS": "true" } },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://YOUR-BACKEND-URL", "EXPO_PUBLIC_USE_TEST_ADS": "true" } },
    "production": { "autoIncrement": true, "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://YOUR-BACKEND-URL", "EXPO_PUBLIC_USE_TEST_ADS": "false" } }
  },
  "submit": { "production": {} }
}
